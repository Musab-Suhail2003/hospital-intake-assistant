# Postgres connection string. Railway injects this when the Postgres addon is attached;
# its postgres:// prefix is rewritten to postgresql:// at startup.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intake

# Shared secret required in the X-API-Key header on POST, PUT and DELETE /patients.
API_KEY=change-me

# Port to bind. Railway injects this; defaults to 8000 when unset.
PORT=8000
