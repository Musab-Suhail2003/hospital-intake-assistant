# Postgres connection string. Railway injects this when the Postgres addon is attached;
# its postgres:// prefix is rewritten to postgresql:// at startup.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intake

# Shared secret required in the X-API-Key header on every write: POST, PUT and DELETE
# /patients, and the /tools/* endpoints Vapi calls.
API_KEY=change-me

# Port to bind. Railway injects this; defaults to 8000 when unset.
PORT=8000

# --- Not read by the app ---
# Only needed to configure Vapi and deploy to Railway from the command line.

# Vapi private API key, sent to api.vapi.ai as "Authorization: Bearer <key>".
VAPI_API_KEY=

# Railway project token (Project Settings -> Tokens), sent to Railway's API as the
# Project-Access-Token header. The Railway CLI reads this variable too.
RAILWAY_TOKEN=
