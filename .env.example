# Postgres connection string (Neon's in production). A postgres:// prefix is rewritten
# to postgresql:// at startup.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intake

# Shared secret required in the X-API-Key header on every write (POST, PUT, DELETE),
# including the /tools/* and /vapi/events endpoints Vapi calls.
API_KEY=change-me

# Port to bind. The host (Render) injects this; defaults to 8000 when unset.
PORT=8000

# Timezone for the mock appointment slots; defaults to America/New_York.
PRACTICE_TIMEZONE=America/New_York

# --- Not read by the app ---
# Only needed to configure Vapi and the host from the command line.

# Vapi private API key, sent to api.vapi.ai as "Authorization: Bearer <key>".
VAPI_API_KEY=

# Render API key (Account Settings -> API Keys), sent to api.render.com as a Bearer token.
RENDER_API_KEY=
